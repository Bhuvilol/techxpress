# /opt/vortex/.env on the server — rendered from SSM Parameter Store
# (/vortex/<env>/...) at deploy time. NEVER commit real values.

# ── deploy settings (used by docker-compose.yml) ─────────────────────────────
VORTEX_ENV=staging
BACKEND_IMAGE=820539072886.dkr.ecr.ap-south-1.amazonaws.com/vortex-backend:<git-sha>
API_DOMAIN=api.3-6-239-100.sslip.io

# ── backend app settings (read by backend/src/config/env.js) ────────────────
LOG_LEVEL=info
# Supabase transaction pooler (port 6543) — used by the running app
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-ap-south-1.pooler.supabase.com:6543/postgres
# Supabase session pooler (port 5432) — used by `prisma migrate deploy`
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-1-ap-south-1.pooler.supabase.com:5432/postgres
ACCESS_TOKEN_SECRET=<64+ random chars>
ACCESS_TOKEN_EXPIRY=8h
BCRYPT_ROUNDS=12
# Frontend origin(s), comma-separated, no trailing slash
CORS_ORIGIN=https://vortex-app.bhuvism003.workers.dev
ADMIN_SEED_EMAIL=<admin email>
ADMIN_SEED_PASSWORD=<strong password>
JURY_SEED_PASSWORD=<strong password>
COORDINATOR_SEED_PASSWORD=<strong password>
# Email (set once SES is configured for the domain)
MAIL_FROM=
MAIL_REPLY_TO=
