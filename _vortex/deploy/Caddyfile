# Public entrypoint for the Vortex API.
#
# {$API_DOMAIN} comes from the environment, e.g.
#   staging (temporary): api.3-6-239-100.sslip.io
#   later:               api.<event-domain>
# Caddy obtains and renews the HTTPS certificate automatically and redirects
# plain HTTP to HTTPS. WebSocket upgrades (Socket.IO) are proxied as-is.

{$API_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy backend:3001
}
