# Local development values. Copy to .env (git-ignored). Production values
# live in Cloud Run env vars and GCP Secret Manager — see docs/CREDENTIALS.md.

NODE_ENV="development"
PORT=3001
LOG_LEVEL="info"

# Local Postgres from the root docker-compose.yml (`npm run dev:db`).
# Cloud Run uses the Cloud SQL socket instead:
#   postgresql://vortex_app:<pw>@localhost/vortex?host=/cloudsql/<PROJECT>:asia-south1:vortex-db
DATABASE_URL="postgresql://vortex_user:vortex_password@localhost:5432/vortex_db?schema=public"

ACCESS_TOKEN_SECRET="local-only-change-me-at-least-32-characters-long"
ACCESS_TOKEN_EXPIRY="8h"

BCRYPT_ROUNDS=12

# Site dev server, portal dev server, wrangler dev.
CORS_ORIGIN="http://localhost:5173,http://localhost:5174,http://localhost:8787"

# Number of proxies in front of the API. 1 = the Vite dev proxy locally, or
# Cloud Run's Google front end in production.
TRUST_PROXY_HOPS=1

# Public site URL, used for the login link in emails.
APP_URL="http://localhost:8787"

# Email via Cloudflare Email Service. Leave MAIL_FROM empty to log emails
# instead of sending (local dev).
MAIL_FROM=""
MAIL_REPLY_TO=""
CF_ACCOUNT_ID=""
CF_EMAIL_API_TOKEN=""

# Bulk test-data import (Admin → Testing). Never true in production.
ENABLE_TESTING_IMPORT="false"

# Seed only (`npm run db:seed`). The admin account; required in production.
ADMIN_SEED_EMAIL="admin@example.test"
ADMIN_SEED_PASSWORD="local-admin-password"
