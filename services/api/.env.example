NODE_ENV="development"
PORT=3001
LOG_LEVEL="info"

DATABASE_URL="postgresql://vortex_user:vortex_password@localhost:5432/vortex_db?schema=public"
DIRECT_URL="postgresql://vortex_user:vortex_password@localhost:5432/vortex_db?schema=public"

ACCESS_TOKEN_SECRET="change-me-32-chars-minimum-please-rotate"
ACCESS_TOKEN_EXPIRY="8h"

BCRYPT_ROUNDS=12

CORS_ORIGIN="http://localhost:80,http://localhost:5173"

ADMIN_SEED_EMAIL="admin@vortex.com"
ADMIN_SEED_PASSWORD="admin123"
JURY_SEED_PASSWORD="jury123"
COORDINATOR_SEED_PASSWORD="coord123"

# Number of reverse proxies in front of the app (rate limiting needs the real
# client IP). 1 = Caddy / nginx / Vite proxy; 2 = Cloudflare → Caddy.
TRUST_PROXY_HOPS=1

# Email via Amazon SES. Leave MAIL_FROM empty to log emails instead of sending
# (local dev). Credentials come from the AWS default provider chain.
MAIL_FROM=""
MAIL_REPLY_TO=""
SES_REGION="ap-south-1"
