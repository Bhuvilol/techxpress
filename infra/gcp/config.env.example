# Copy to infra/gcp/config.env (git-ignored) and fill in. No secrets here:
# passwords and tokens go straight into Secret Manager (see README.md).

PROJECT_ID=""                 # e.g. techxpress-prod
REGION="asia-south1"          # Mumbai

# GitHub repository allowed to deploy (owner/name). Its numeric ID is looked
# up with `gh api` unless GITHUB_REPO_ID is set.
GITHUB_REPO=""                # e.g. Bhuvilol/techxpress
GITHUB_REPO_ID=""

# Where alert emails go (uptime, database, error rate).
ALERT_EMAIL=""

# Budget alert (stage "budget"). BUDGET_AMOUNT uses the billing account's
# currency, e.g. "10000INR" or "150USD".
BILLING_ACCOUNT_ID=""         # e.g. 0123AB-4567CD-89EF01
BUDGET_AMOUNT=""

# Public site origins allowed to call the API (comma-separated), and the site
# URL used in email links. Update after the domain is attached, then re-run
# `setup.sh core` (it only updates the service's environment).
CORS_ORIGIN="http://localhost:5174"
APP_URL=""
MAIL_FROM=""                  # e.g. TechXpress <noreply@your-domain>
MAIL_REPLY_TO=""              # organizer inbox
CF_ACCOUNT_ID=""

# Admin account the seed creates (its password goes in Secret Manager).
ADMIN_SEED_EMAIL=""

# Optional: block Cloud SQL maintenance over the event (YYYY-MM-DD).
MAINTENANCE_FREEZE_START=""
MAINTENANCE_FREEZE_END=""
