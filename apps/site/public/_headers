# Cloudflare static asset headers for the whole Worker (dist/_headers).
# Vite puts content hashes in these file names, so they can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable

/vortex/assets/*
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable

# Page shells must be revalidated so a new deploy is picked up immediately.
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/vortex/
  Cache-Control: no-cache

/vortex/index.html
  Cache-Control: no-cache
