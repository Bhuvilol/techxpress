# Backend base URL, baked in at build time.
# Leave empty locally: `npm run dev` proxies /api and /socket.io to :3001.
# Production: the Cloud Run URL, set as a Cloudflare Workers Builds variable.
VITE_API_URL=

# Show Admin → Testing (bulk test-data import). Needs the API's
# ENABLE_TESTING_IMPORT=true too. Keep off in production.
VITE_ENABLE_TESTING=false
